<Window x:Class="Client.Controls.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход / Регистрация"
        Height="260" Width="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" HorizontalAlignment="Center" WindowStyle="None" Background="Transparent">

    <Border Background="#FF1E1E1E">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Логин -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Label Content="Логин:" Width="70" VerticalAlignment="Center" Foreground="#777777"/>
                <TextBox x:Name="TbLogin"
                     Width="200"
                     MinWidth="150"
                     VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Пароль -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Label Content="Пароль:" Width="70" VerticalAlignment="Center" Foreground="#777777"/>
                <PasswordBox x:Name="PbPassword"
                         Width="200"
                         MinWidth="150"
                         VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Сообщение об ошибке -->
            <TextBlock x:Name="TbError"
                   Grid.Row="2"
                   Foreground="Red"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button x:Name="BtnLogin"
                    Content="Войти"
                    Width="100"
                    Margin="5"
                    Click="BtnLogin_Click"/>
                <Button x:Name="BtnRegister"
                    Content="Регистрация"
                    Width="100"
                    Margin="5"
                    Click="BtnRegister_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
