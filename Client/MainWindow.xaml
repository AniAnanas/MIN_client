<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        xmlns:vm="clr-namespace:Client.ViewModels"
        xmlns:converters="clr-namespace:Client.Converters"
        xmlns:Controls="clr-namespace:Client.Controls"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="MIN Messager"
        d:Width="1920" 
        d:Height="1080"
        Icon="/content/icon1.png"
        Background="#FF1F1F1F" 
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        MinWidth="800"
        MinHeight="600">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
        <converters:OnlineStatusConverter x:Key="OnlineStatusConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="280"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="Auto" MinWidth="280"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Controls:TopBarUI x:Name="topBar"
                Grid.Row="0" 
                Grid.Column="0" 
                Grid.ColumnSpan="3"/>

        <Border Name="LeftBorder"
                Grid.Column="0"
                Grid.Row="1"
                Background="Transparent"
                BorderBrush="#4C000000"
                BorderThickness="2"
                CornerRadius="15"
                Margin="7">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Chat List -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding TabListViewModel.Chats}" 
                            SelectedItem="{Binding TabListViewModel.SelectedChat, Mode=TwoWay}" 
                            BorderThickness="0" 
                            Background="Transparent"
                            HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Controls:TabUI/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="1,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>

                <!-- Add Button -->
                <Controls:AddButtonUI Grid.Row="1" Margin="0,10,0,10"/>
            </Grid>

        </Border>

        <Border x:Name="CenterBorder"
                Grid.Column="1"
                Grid.Row="1"
                Background="Transparent"
                BorderBrush="#4C000000"
                BorderThickness="2"
                CornerRadius="15"
                Margin="0,7">
            <Grid>
                <Border Height="28" Width="288"
                        Padding="1"
                        Background="#77666666"
                        CornerRadius="14"
                        Visibility="{Binding IsChatSelected, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="Выберите, кому хотели бы написать"
                            FontSize="14" FontWeight="Medium"
                            Foreground="#FFCCCCCC"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    
                </Border>
                <Controls:ChatUI DataContext="{Binding CurrentChatViewModel}"
                        Visibility="{Binding DataContext.IsChatSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" 
                        Margin="2"/>
            </Grid>
        </Border>

        <Border x:Name="RightBorder"
                Grid.Column="2"
                Grid.Row="1"
                Background="Transparent"
                BorderBrush="#4C000000"
                BorderThickness="2"
                CornerRadius="15"
                Margin="7">
            <Grid>
                <TextBlock Text="User Info"
                        FontSize="16"
                        Foreground="#777777"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
